{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  // Tests are excluded from the build so they stay out of dist/. They are still
  // typechecked, via tsconfig.test.json — `tsx --test` strips types without
  // checking them, so excluding them here and nowhere else left them unchecked.
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
