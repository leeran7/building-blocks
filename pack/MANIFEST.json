{
  "name": "closed-loop-agents",
  "version": "2.0.0",
  "description": "Reusable closed-loop agent pack. Product code (app/) is not in this manifest.",
  "kernel": [
    "INDEX.md",
    "RULES.md",
    "MAP.md",
    "agents/*.md",
    "agents/claude.config.json",
    "skills/closed-loop/*.md",
    "workflows/**",
    "domains/**",
    "knowledge/**",
    "references/**",
    "archive/INDEX.md",
    "loop/INDEX.md",
    "handoffs/schema.json",
    "pack/**",
    "scripts/*.mjs",
    "orchestrator/package.json",
    "orchestrator/tsconfig.json",
    "orchestrator/tsconfig.test.json",
    "orchestrator/src/**",
    "orchestrator/yarn.lock"
  ],
  "doNotCopy": [
    "app/**",
    "loop/learnings.md",
    "loop/learnings.jsonl",
    "closed-loop.profile.json",
    "context/**",
    "CLAUDE.md",
    "CHANGELOG.md",
    "docs/reviews/**",
    "archive/reviews/**",
    "archive/package-upgrade.md",
    "docs/runbook.md",
    "docs/observability.md",
    "docs/deploy.md"
  ]
}
