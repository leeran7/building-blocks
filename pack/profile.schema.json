{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClosedLoopRepoProfile",
  "type": "object",
  "required": ["name", "packageManagers"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "product": { "type": "string" },
    "packageManagers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "command"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "command": { "type": "string", "enum": ["yarn", "pnpm", "npm"] }
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec": { "type": "string" },
        "architecture": { "type": "string" },
        "learnings": { "type": "string" },
        "design": { "type": "string" },
        "gates": { "type": "string" },
        "trust": { "type": "string" },
        "git": { "type": "string" },
        "conventions": { "type": "string" }
      }
    },
    "requiredTeam": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
