{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClosedLoopHandoff",
  "type": "object",
  "required": ["agent", "status", "summary", "timestamp"],
  "properties": {
    "agent": {
      "type": "string",
      "description": "Agent that produced this handoff"
    },
    "status": {
      "type": "string",
      "enum": ["success", "blocked", "failed", "needs_revision"]
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph summary of what was done or found"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "goal": {
      "type": "string",
      "description": "What this stage was trying to achieve"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to files created or modified"
    },
    "exitCriteria": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "warning", "info"]
          },
          "message": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "action": { "type": "string" }
        }
      }
    },
    "learnings": {
      "type": "array",
      "description": "Cross-agent findings pinged at other agents; each is also appended to loop/learnings.jsonl",
      "items": {
        "type": "object",
        "required": ["forAgents", "insight", "action"],
        "properties": {
          "topic": { "type": "string" },
          "forAgents": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agents that should apply this learning; use [\"all\"] for global"
          },
          "kind": {
            "type": "string",
            "enum": ["lesson", "pattern", "pitfall", "metric", "question"]
          },
          "insight": { "type": "string" },
          "action": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "nextStage": {
      "type": "string",
      "description": "Recommended next agent in the loop"
    },
    "loopBackTo": {
      "type": "string",
      "description": "Agent to return to when status is needs_revision or failed"
    }
  }
}
