# Loop runtime artifacts
.cursor/loop/handoffs/*.json
.cursor/loop/state.json
.cursor/loop/*.md
# loop/* with negation to keep learnings.md (open questions only).
# Handoff JSONs are transient scratch — written to disk during a run, read by
# the next stage and the retro, then no longer needed. The retro promotes their
# findings into docs/agents/skills, so nothing durable is lost by not tracking
# them. Keeping them out of git avoids bloating every PR diff.
loop/*
!loop/learnings.md
!loop/*.md
.claude/handoffs/*.json

# Dependencies & build
node_modules/
dist/
*.log

# Environment
.env
.env.local

# Deploy tooling (may contain auth tokens / local project links)
.vercel
.firebaserc
scratch
.next
__pycache__/

# render-3d MCP server default output (RENDER_3D_OUT_BASE)
render-3d-out/
