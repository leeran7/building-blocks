// prisma/schema.prisma
// Doomstack data model: free Climb game, 1v1 Duels, prepaid-credits wallet,
// creator profiles, and the single-tenant social-media agent.
// The original paid-stacks monetization (Block/Season/Payment) was removed in
// favour of Paid 1v1 Battles; see migration <ts>_drop_paid_stacks.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; rhel-openssl-3.0.x is the Vercel (Linux x64) target.
  // Listing only these two prevents Prisma from generating macOS/arm64/Windows
  // engine binaries that would inflate function storage by ~30-40 MB each.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime uses the POOLED connection (Neon -pooler / PgBouncer) so serverless
  // functions share connections instead of exhausting Postgres at scale.
  url       = env("DATABASE_URL")
  // Migrations need a DIRECT (non-pooled) connection. Set both in every env.
  directUrl = env("DIRECT_URL")
}

// Categories are a free-form slug (String), data-driven from src/game/categories
// (74+ subcategories), not a fixed enum — new categories ship without a migration.

// Platforms a creator can save a handle for (buyer-facing). Adding one is one
// enum value + one PLATFORM_META entry + one glyph.
enum CreatorPlatform {
  TIKTOK
  X
  YOUTUBE
  INSTAGRAM
  TWITCH
}

model User {
  id                     String              @id // Firebase UID
  email                  String              @unique
  emailVerified          Boolean             @default(false)
  display_name           String? // profile display name (optional)
  // Public, user-chosen handle for the creator page at /c/[username].
  // Slug-safe, unique, moderated. NULL = no public profile yet.
  username               String?             @unique
  createdAt              DateTime            @default(now())
  // Non-cashable chip balance for ranked duels and tournaments. Cents
  // (1 chip = 1¢), ALWAYS mutated with increment/decrement (never SET) so
  // concurrent stakes/payouts stay correct. Purchased or won, never cashable
  // and never withdrawn — see loop/design.md for the compliance rationale.
  play_credits_cents     Int                 @default(0)
  // 18+ attestation timestamp, set on the user's first paid-duel action.
  age_confirmed_at       DateTime?
  // Last time this user claimed the daily free-chip grant — the ongoing
  // free-play alternative to purchase (compliance requirement, not a promo).
  last_daily_chips_claim_at DateTime?
  // Stripe Connect Express account for receiving tournament prize payouts.
  stripe_connect_account_id String?
  // Beta app waitlist — set when the user opts in to the native iOS beta.
  beta_waitlist_joined_at  DateTime?
  beta_platform            String?   // "ios" (legacy rows may hold "android"/"any")
  apple_tester_added       Boolean   @default(false)
  leaderboard_consent_at   DateTime? @map("leaderboard_consent_at")
  // Profile avatar catalogue id (src/lib/avatars.ts). Not a FK: reads pass it
  // through parseAvatarId, so a retired id falls back to the initials badge.
  avatar_id                String?   @map("avatar_id")
  // Level System (mobile). All SERVER-DERIVED: xp only rises through an
  // xp_grants insert in the same transaction (src/db/levels.ts), and
  // player_level is a cache of playerLevelForXp(xp). lives is the stored count;
  // the refill (1 per 30 min, max 5) is applied on read and write from
  // lives_updated_at, which moves forward in whole 30-minute steps only.
  xp                       Int       @default(0)
  player_level             Int       @default(1)
  lives                    Int       @default(5)
  lives_updated_at         DateTime?
  // First clears in a row at the frontier (design §6.3). Server-derived from
  // ticket outcomes in src/db/levels.ts; replays and bad starts leave it alone.
  level_streak             Int       @default(0)
  // Stuck help (design §5c): fails and abandoned tickets at ONE frontier level
  // (season + level), reset by clearing it. Server-derived like the streak.
  level_fail_season        Int?
  level_fail_level         Int?
  level_fail_count         Int       @default(0)
  // UTC day (YYYY-MM-DD) the once-a-day bonus life for finishing a Daily
  // Climb or a duel was last paid (design §5b). Null = never.
  bonus_life_day           String?
  // Shop gems (src/db/gems.ts). SERVER-DERIVED: rises only by a verified
  // gem-pack purchase (gem_purchases) and falls only by a spend, each under
  // the user row lock with one gem_ledger row. A CHECK keeps it >= 0.
  gems                     Int       @default(0)
  climbRecords           ClimbRecord[]
  climbRuns              ClimbRun[]
  dailyClimbScores       DailyClimbScore[]
  dailyClimbReplays      DailyClimbReplay[]
  socialHandles          SavedSocialHandle[]
  duelsAsPlayer1         Duel[]              @relation("DuelPlayer1")
  duelsAsPlayer2         Duel[]              @relation("DuelPlayer2")
  duelsWon               Duel[]              @relation("DuelWinner")
  duelStats              DuelStats?
  creditPurchases        CreditPurchase[]
  walletLedger           WalletLedger[]
  tournamentEntries      TournamentEntry[]
  challengesSent         Challenge[]         @relation("ChallengeSender")
  challengesReceived     Challenge[]         @relation("ChallengeRecipient")
  notifications          Notification[]
  friendshipsSent        Friendship[]        @relation("FriendshipSender")
  friendshipsReceived    Friendship[]        @relation("FriendshipReceiver")
  pushTokens             PushToken[]
  levelRunTickets        LevelRunTicket[]
  levelProgress          LevelProgress[]
  xpGrants               XpGrant[]
  boosters               UserBooster[]
  starChests             StarChest[]
  gemLedger              GemLedger[]
  gemPurchases           GemPurchase[]
  ownedCharacters        OwnedCharacter[]

  @@map("users")
}

// A social handle the user has saved, one per platform, so it prefills at submit
// and renders as a chip on their creator page. Unique per (user, platform).
model SavedSocialHandle {
  id         String          @id @default(cuid())
  userId     String
  platform   CreatorPlatform
  handle     String
  created_at DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform], name: "saved_social_user_platform")
  @@index([userId])
  @@map("saved_social_handles")
}

// Tower v3 "The Climb": permanent peak-height record per user per category.
// Monotonic — peak_y is only ever raised, mirroring the "altitude is permanent"
// invariant (spec-next.md AC-30/AC-31). Enforced in recordClimb() + app logic.
model ClimbRecord {
  id            String   @id @default(cuid())
  userId        String
  category_slug String
  peak_y        Float    @default(0) // best peak height reached, metres
  wins          Int      @default(0) // first-place finishes in this category
  updated_at    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One record row per (user, category).
  @@unique([userId, category_slug], name: "climb_record_user_category")
  @@index([category_slug, peak_y(sort: Desc)], name: "climb_record_leaderboard_idx")
  @@map("climb_records")
}

// Individual run result (history / audit). Ranked runs also store seed for
// re-simulation-based verification (AC-17) — added when ranked ships.
model ClimbRun {
  id            String   @id @default(cuid())
  userId        String?
  category_slug String
  peak_y        Float
  finished      Boolean  @default(false)
  finished_tick Int?
  seed          String
  /**
   * Deflate-packed input log for deterministic replay (/play?r=…).
   */
  replay_token  String?
  created_at    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category_slug, created_at], name: "climb_run_category_idx")
  @@index([userId, created_at(sort: Desc)], name: "climb_run_user_idx")
  @@map("climb_runs")
}

// Daily Climb: one row per (user, UTC day) holding that day's best verified
// run. peak_y is SERVER-DERIVED — POST /api/climb/daily/result re-simulates
// the submitted replay and stores the re-simulated height, never the client's
// claim. Monotonic within a day: the upsert keeps GREATEST(peak_y), so no race
// or later worse run can lower it. updated_at is when the current best was
// SET (not last touched) and breaks ties on the board: first to reach wins.
model DailyClimbScore {
  id           String   @id @default(cuid())
  userId       String
  day          String // UTC day key "YYYY-MM-DD" (src/lib/dailyDay.ts)
  peak_y       Float // best re-simulated peak height today, metres
  ticks        Int // length of the best run, in sim ticks
  replay_token String? // replay of the best run (/play?r=…)
  // Engine revision the best run was verified under (DAILY_SIM_VERSION).
  // Replays carry no engine version, so this is how rows verified before a
  // stepMatch/obstacle change are found afterwards.
  sim_version  Int      @default(1)
  attempts     Int      @default(1) // verified runs submitted for this day
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day], name: "daily_climb_user_day")
  @@index([day, peak_y(sort: Desc), updated_at], map: "daily_climb_board_idx")
  @@map("daily_climb_scores")
}

// One row per distinct verified daily run: the canonical input-log hash
// (src/game/dailyVerify.ts dailyInputHash) and the first account that
// submitted it that day. POST /api/climb/daily/result claims the hash before
// saving, and a run already claimed by ANOTHER account is refused with 409
// REPLAY_REUSED (SEC-DC-2: replay tokens are public). This blocks exact and
// tail-padded copies only. A copy with one no-effect input changed hashes
// differently and is accepted: an accepted residual, because it can only
// tie the original and ties rank the earlier run first. Runs below
// DAILY_CLAIM_MIN_PEAK_M (SEC-DC-11) or with fewer than
// DAILY_CLAIM_MIN_INPUT_SEGMENTS input segments (SEC-DC-15, held-input runs)
// are never claimed, since honest players repeat them exactly. Every claimed run is kept, not only the best, so an
// earlier run cannot be exact-copied after its owner beats it.
model DailyClimbReplay {
  id         String   @id @default(cuid())
  day        String // UTC day key "YYYY-MM-DD"
  input_hash String // SHA-256 hex of the canonical input log
  userId     String // first account to submit this run for the day
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([day, input_hash], map: "daily_climb_replays_day_hash_key")
  @@index([userId], map: "daily_climb_replays_user_idx")
  @@map("daily_climb_replays")
}

// ═══════════════════════════════════════════════════════════════════════════
// Level System (mobile only): seasons, run tickets, progress, XP
// design/xp-and-levels.md §5, §9. Every row here is written by
// src/db/levels.ts. Run results are the device's report (no replay check,
// Leeran 2026-09-27); tickets, lives, unlocks and XP keys are server-side.
// ═══════════════════════════════════════════════════════════════════════════

// A season the server will issue tickets for: inserting this row switches it
// on. A ticket is issued only once starts_at has passed. Named level_seasons:
// the old paid-stacks "Season" model was dropped.
model LevelSeason {
  id                    Int      @id // season number, 1-based
  name                  String
  starts_at             DateTime
  // Oldest LEVEL_SIM_VERSION that can play this season (new mechanics).
  min_level_sim_version Int      @default(1)
  created_at            DateTime @default(now())

  @@map("level_seasons")
}

// One level attempt. Issued by POST /api/levels/ticket (which spends the
// life), consumed once by POST /api/levels/result. The consume is
// UPDATE ... WHERE used_at IS NULL under the user's row lock, so two submits
// of one ticket cannot both refund a life or pay XP. At most one open ticket
// per user: issuing a new one closes the old one as abandoned (no refund).
model LevelRunTicket {
  id             String    @id @default(cuid())
  userId         String
  season         Int
  level          Int
  sim_version    Int // LEVEL_SIM_VERSION at issue
  start_power_up String? // granted at GO: a streak or stuck-help power-up, or a booster
  life_spent     Boolean // false on free levels (L1-10)
  // Booster spent from the inventory for this run (design §6.4), or null.
  // Refunded only when the run ends as a bad start.
  booster        String?
  created_at     DateTime  @default(now())
  expires_at     DateTime
  used_at        DateTime?
  // cleared | failed | bad_start | abandoned. Null while open.
  outcome        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used_at], map: "level_run_tickets_user_open_idx")
  @@map("level_run_tickets")
}

// Best reported result per (user, season, level). stars and best_ticks only
// ever improve: read and written under the user's row lock. A row exists
// only once a level is cleared, so the frontier is MAX(level) + 1.
model LevelProgress {
  id             String   @id @default(cuid())
  userId         String
  season         Int
  level          Int
  stars          Int // 1..3
  best_ticks     Int // fastest reported finish, race ticks from GO
  sim_version    Int
  start_power_up String?
  replay_token   String? // replay of the best_ticks run (unverified), for ghosts
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) // when best_ticks was last set

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season, level], name: "level_progress_user_level", map: "level_progress_user_level_key")
  @@index([season, level, best_ticks, updated_at], map: "level_progress_board_idx")
  @@map("level_progress")
}

// Every XP payment, keyed so it happens once: first_clear:{S}:{N},
// star:{S}:{N}:{k}, episode:{S}:{E}. Inserted with ON CONFLICT DO NOTHING,
// and users.xp rises only by the rows actually inserted. No key carries a
// seed or version, so a re-rolled level never pays twice.
// Level boosters (design §6.4): power-ups a player owns and may equip, one
// per run, as the ticket's start power-up. SERVER-DERIVED: rows only grow
// from star chests and shrink by a ticket issue, both under the user lock
// (src/db/levels.ts). One row per (user, type); type is a concrete power-up.
model UserBooster {
  id         String   @id @default(cuid())
  userId     String
  type       String
  count      Int      @default(0)
  updated_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type], name: "user_booster_type", map: "user_boosters_user_type_key")
  @@map("user_boosters")
}

// Star chests (design §6.4): one per 20 lifetime stars, rolled once from
// HMAC(STAR_CHEST_SECRET, "<userId>:<chestNumber>"). Unique per (user, chest)
// so a chest can never be opened or paid twice.
model StarChest {
  id           String   @id @default(cuid())
  userId       String
  chest_number Int
  boosters     String[]
  created_at   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chest_number], name: "star_chest_user_number", map: "star_chests_user_number_key")
  @@map("star_chests")
}

model XpGrant {
  id         String   @id @default(cuid())
  userId     String
  source     String
  key        String
  amount     Int
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, key], map: "xp_grants_user_key")
  @@map("xp_grants")
}

// ═══════════════════════════════════════════════════════════════════════════
// In-app challenges & notifications
// ═══════════════════════════════════════════════════════════════════════════

enum ChallengeStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

// A targeted 1v1 invitation from one user to another. Decoupled from Duel
// until accepted — a Duel is only created when the recipient accepts.
model Challenge {
  id             String          @id @default(cuid())
  sender_id      String
  recipient_id   String
  category_slug  String
  status         ChallengeStatus @default(pending)
  duel_id        String?
  expires_at     DateTime
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  sender    User  @relation("ChallengeSender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient User  @relation("ChallengeRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([sender_id, status], name: "challenge_sender_status_idx")
  @@index([recipient_id, status], name: "challenge_recipient_status_idx")
  @@index([expires_at], name: "challenge_expires_at_idx")
  @@map("challenges")
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

model Friendship {
  id          String           @id @default(cuid())
  sender_id   String
  receiver_id String
  status      FriendshipStatus @default(pending)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  sender   User @relation("FriendshipSender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id], name: "friendship_pair")
  @@index([receiver_id, status], name: "friendship_receiver_status_idx")
  @@map("friendships")
}

enum NotificationType {
  challenge_received
  challenge_accepted
  challenge_declined
  challenge_expired
  duel_result
  duel_rematch
  friend_request
  friend_accepted
  tournament_started
  tournament_round_ready
  tournament_complete
  daily_chips
  system
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType
  title      String
  body       String
  data       Json?
  read       Boolean          @default(false)
  created_at DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read, created_at(sort: Desc)], name: "notification_user_read_idx")
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(cuid())
  user_id    String
  token      String   @unique
  platform   String   // "ios" | "android"
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "push_token_user_idx")
  @@map("push_tokens")
}

model PaymentDeadLetter {
  id                String   @id @default(cuid())
  stripe_session_id String
  event_type        String
  amount_cents      Int
  reason            String
  created_at        DateTime @default(now())

  @@index([stripe_session_id])
  @@map("payment_dead_letters")
}

// ═══════════════════════════════════════════════════════════════════════════
// 1v1 Duel multiplayer mode
// ═══════════════════════════════════════════════════════════════════════════

enum DuelStatus {
  pending
  active
  completed
  voided
}

// Partial unique index (Prisma schema can't express a WHERE-qualified unique
// index) — one open paid waiting room per user, enforced at the DB layer so a
// check-then-create race can't stake a second room. See migration
// 20260910050000_one_open_paid_room_per_user.
// CREATE UNIQUE INDEX duel_one_open_paid_room_per_user ON duels (player1_id) WHERE (status = 'pending' AND stake_cents IS NOT NULL AND player2_id IS NULL)
model Duel {
  id                String     @id
  seed              String
  category_slug     String
  status            DuelStatus @default(pending)
  player1_id        String
  player2_id        String?
  winner_id         String?
  player1_peak      Float?
  player2_peak      Float?
  player1_replay    String?    @db.Text
  player2_replay    String?    @db.Text
  player1_submitted Boolean    @default(false)
  player2_submitted Boolean    @default(false)
  forfeit           Boolean    @default(false)
  tiebreak_rule     String?
  created_at        DateTime   @default(now())
  started_at        DateTime?
  completed_at      DateTime?
  /**
   * Set on a completed duel when a rematch is created; lets the opponent
   * discover the new room even if the realtime "rematch" event is dropped.
   */
  rematch_duel_id   String?

  // ── Tournament bracket (NULL tournament_id = standalone duel, not part of a bracket) ──
  tournament_id     String?
  tournament_round  Int?
  bracket_position  Int?
  is_bye            Boolean    @default(false)

  // ── Ranked chip duel (zero-sum, non-cashable — chips only, no real money) ──
  is_chip_duel          Boolean    @default(false)

  // ── Chip duel escrow (NULL stake_cents = free duel; all free paths untouched) ──
  // Per-player stake in cents. Both players stake the same amount; the winner
  // takes the full stake_cents * 2 pot, zero-sum — no rake, since only the
  // initial chip sale is monetized, never a match outcome.
  stake_cents                  Int?
  player1_staked               Boolean @default(false)
  player2_staked               Boolean @default(false)
  // Recorded at stake time so a refund restores exactly what was taken.
  player1_stake_play_cents     Int     @default(0)
  player2_stake_play_cents     Int     @default(0)
  // Exactly-once settlement guards, flipped inside the resolving SELECT FOR UPDATE tx.
  payout_settled               Boolean @default(false)
  payout_cents                 Int?
  refunded                     Boolean @default(false)

  player1      User           @relation("DuelPlayer1", fields: [player1_id], references: [id], onDelete: Restrict)
  player2      User?          @relation("DuelPlayer2", fields: [player2_id], references: [id], onDelete: SetNull)
  winner       User?          @relation("DuelWinner", fields: [winner_id], references: [id], onDelete: SetNull)
  tournament   Tournament?    @relation(fields: [tournament_id], references: [id], onDelete: SetNull)
  walletLedger WalletLedger[]

  @@index([status, created_at], name: "duel_status_created_idx")
  @@index([player1_id, status], name: "duel_player1_status_idx")
  @@index([player2_id, status], name: "duel_player2_status_idx")
  @@index([tournament_id, tournament_round], name: "duel_tournament_round_idx")
  @@map("duels")
}

model DuelStats {
  user_id        String   @id
  wins           Int      @default(0)
  losses         Int      @default(0)
  current_streak Int      @default(0)
  best_streak    Int      @default(0)
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([wins(sort: Desc)], name: "duel_stats_wins_desc_idx")
  @@map("duel_stats")
}

// ═══════════════════════════════════════════════════════════════════════════
// Tournaments — bracket of 1v1 duels, paid entry, company-guaranteed prizes
// ═══════════════════════════════════════════════════════════════════════════

enum TournamentStatus {
  REGISTRATION
  SEEDED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tournament {
  id                      String           @id @default(cuid())
  name                    String
  category_slug           String
  entry_fee_cents         Int
  prize_structure         Json
  bracket_size            Int
  status                  TournamentStatus @default(REGISTRATION)
  current_round           Int              @default(0)
  registration_opens_at   DateTime
  registration_closes_at  DateTime
  started_at              DateTime?
  completed_at            DateTime?
  created_by_uid          String
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  entries TournamentEntry[]
  duels   Duel[]

  @@index([status, registration_closes_at], name: "tournament_status_reg_close_idx")
  @@index([category_slug, status], name: "tournament_category_status_idx")
  @@map("tournaments")
}

model TournamentEntry {
  id                       String   @id @default(cuid())
  tournament_id            String
  user_id                  String
  seed_position            Int?
  placement                Int?
  prize_cents              Int?
  eliminated_in_round      Int?
  stripe_connect_account_id String?
  stripe_transfer_id       String?
  payout_status            String?
  registered_at            DateTime @default(now())

  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, user_id], name: "tournament_entry_user")
  @@index([tournament_id], name: "tournament_entry_tournament_idx")
  @@index([user_id], name: "tournament_entry_user_idx")
  @@map("tournament_entries")
}

// ═══════════════════════════════════════════════════════════════════════════
// Paid 1v1 Battles — prepaid credits wallet
// ═══════════════════════════════════════════════════════════════════════════

// Single non-cashable chip bucket. Kept as an enum (rather than dropped
// entirely) so WalletLedger rows stay self-describing without a join.
enum WalletBucket {
  PLAY
}

// Every credit-balance mutation writes one append-only ledger row, so the
// wallet is fully auditable and balance_after can be reconciled against the
// running total.
enum WalletLedgerKind {
  PURCHASE // chips bought via Stripe
  DAILY_GRANT // free daily chip grant — the ongoing no-purchase play path
  STAKE // debit into a duel escrow
  WIN // pot credited to the winner
  REFUND // stake returned when a duel never played
  ADJUSTMENT // manual admin correction
}

// A settled Stripe credit top-up. stripe_session_id is UNIQUE — the webhook's
// idempotency key, mirroring Payment for paid stacks.
model CreditPurchase {
  id                String   @id @default(cuid())
  user_id           String
  stripe_session_id String   @unique
  amount_cents      Int
  created_at        DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("credit_purchases")
}

model WalletLedger {
  id            String           @id @default(cuid())
  user_id       String
  bucket        WalletBucket
  amount_cents  Int // signed: positive = credit, negative = debit
  balance_after Int // that bucket's balance after this row, for auditability
  kind          WalletLedgerKind
  duel_id       String? // set for STAKE / WIN / REFUND
  note          String?
  created_at    DateTime         @default(now())

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  duel Duel? @relation(fields: [duel_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)], name: "wallet_ledger_user_idx")
  @@map("wallet_ledger")
}

// ═══════════════════════════════════════════════════════════════════════════
// Shop — gems, gem packs and paid characters / skins (src/db/gems.ts)
// ═══════════════════════════════════════════════════════════════════════════

enum GemLedgerKind {
  PURCHASE // a gem pack bought (Stripe on web, App Store on iOS)
  SPEND // gems spent in the Shop (a character, a skin, lives)
  REFUND // a spend returned
  ADJUSTMENT // manual admin correction
}

// Every users.gems change writes one append-only row carrying balance_after.
// idempotency_key is UNIQUE, so a retried spend or credit applies once.
model GemLedger {
  id              String        @id @default(cuid())
  user_id         String
  amount          Int // signed: positive = credit, negative = debit
  balance_after   Int
  kind            GemLedgerKind
  // What the gems were for: "gem_pack", "character", "lives", ...
  reason          String
  // The pack, avatar id or other thing bought, when there is one.
  ref             String?
  idempotency_key String        @unique
  created_at      DateTime      @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], name: "gem_ledger_user_idx")
  @@map("gem_ledger")
}

// A settled gem-pack purchase. (provider, external_id) is UNIQUE: the Stripe
// Checkout session id or the App Store transaction id, so one payment credits
// once whichever path reports it first.
model GemPurchase {
  id          String   @id @default(cuid())
  user_id     String
  provider    String // "stripe" | "apple"
  external_id String
  pack_id     String
  gems        Int
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, external_id], name: "gem_purchase_provider_external", map: "gem_purchases_provider_external_key")
  @@index([user_id])
  @@map("gem_purchases")
}

// A character or skin bought with gems (a `purchase` rule in src/lib/avatars.ts).
// Owning it is what makes it selectable; never derived from level data.
model OwnedCharacter {
  id         String   @id @default(cuid())
  user_id    String
  avatar_id  String
  gems_paid  Int
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, avatar_id], name: "owned_character_user_avatar", map: "owned_characters_user_avatar_key")
  @@map("owned_characters")
}
