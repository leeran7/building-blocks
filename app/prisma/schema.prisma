// prisma/schema.prisma
// Tower data model
// Critical constraints:
// - altitude has CHECK (altitude >= 0) — applied in migration
// - views_k has CHECK (views_k >= 0) — applied in migration
// - NO position/rank column (AC-20) — rank is derived via ORDER BY altitude DESC
// - spend_c is NEVER in ORDER BY (AC-17) — display only
// - stripe_session_id is UNIQUE — idempotency mechanism (NFR-D1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime uses the POOLED connection (Neon -pooler / PgBouncer) so serverless
  // functions share connections instead of exhausting Postgres at scale.
  url       = env("DATABASE_URL")
  // Migrations need a DIRECT (non-pooled) connection. Set both in every env.
  directUrl = env("DIRECT_URL")
}

// Category is now a free-form slug (String), not a fixed enum: every subcategory
// (74+, per src/game/categories) gets its own paid tower + season, not just 6.

model User {
  id            String   @id // Firebase UID
  email         String   @unique
  emailVerified Boolean  @default(false)
  display_name  String? // profile display name (optional)
  createdAt     DateTime @default(now())
  blocks        Block[]
  climbRecords  ClimbRecord[]
  climbRuns     ClimbRun[]
  savedUrls     SavedUrl[]

  @@map("users")
}

// A URL the user has saved (from settings or a previous submission) so they can
// pick it again instead of retyping. Unique per (user, url).
model SavedUrl {
  id         String   @id @default(cuid())
  userId     String
  url        String
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url], name: "saved_url_user_url")
  @@index([userId])
  @@map("saved_urls")
}

// Tower v3 "The Climb": permanent peak-height record per user per category.
// Monotonic — peak_y is only ever raised, mirroring the "altitude is permanent"
// invariant (spec-next.md AC-30/AC-31). Enforced in recordClimb() + app logic.
model ClimbRecord {
  id            String   @id @default(cuid())
  userId        String
  category_slug String
  peak_y        Float    @default(0) // best peak height reached, metres
  wins          Int      @default(0) // first-place finishes in this category
  updated_at    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One record row per (user, category).
  @@unique([userId, category_slug], name: "climb_record_user_category")
  @@index([category_slug, peak_y(sort: Desc)], name: "climb_record_leaderboard_idx")
  @@map("climb_records")
}

// Individual run result (history / audit). Ranked runs also store seed for
// re-simulation-based verification (AC-17) — added when ranked ships.
model ClimbRun {
  id            String   @id @default(cuid())
  userId        String?
  category_slug String
  peak_y        Float
  finished      Boolean  @default(false)
  finished_tick Int?
  seed          String
  /** Deflate-packed input log for deterministic replay (/play?r=…). */
  replay_token  String?
  created_at    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([category_slug, created_at], name: "climb_run_category_idx")
  @@index([userId, created_at(sort: Desc)], name: "climb_run_user_idx")
  @@map("climb_runs")
}

model Block {
  id           String    @id @default(cuid())
  slug         String    @unique
  url          String
  display_name String
  owner_email  String
  altitude     Float     @default(0) // metres; CHECK altitude >= 0 in migration
  spend_c      Int       @default(0) // cents; display-only; NEVER in ORDER BY
  views_served Int       @default(0) // above-ground views only
  clicks       Int       @default(0)
  peak_rank    Int? // best (lowest) rank number achieved
  hidden_at    DateTime? // NULL = visible
  created_at   DateTime  @default(now())
  season_id    String
  category     String?   @default("tech") // free-form category slug
  userId       String?

  season   Season    @relation(fields: [season_id], references: [id])
  payments Payment[]
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Partial index on altitude DESC WHERE hidden_at IS NULL (for rank query)
  // Raw SQL applied in migration 0002 (Prisma @@index with where clause):
  @@index([altitude(sort: Desc)], name: "blocks_rank_idx")
  @@index([category, altitude(sort: Desc)], name: "blocks_category_altitude_idx")
  @@map("blocks")
}

model Season {
  id        String   @id @default(cuid())
  views_k   Float    @default(0) // cumulative qualified views / 1000; CHECK views_k >= 0
  starts_at DateTime
  ends_at   DateTime
  is_active Boolean  @default(false)
  category  String   @default("tech") // free-form category slug

  blocks Block[]

  // Partial unique index enforced in migration SQL:
  // CREATE UNIQUE INDEX season_one_active_per_category ON season_state (category) WHERE (is_active = true)
  @@map("season_state")
}

model Payment {
  id                String   @id @default(cuid())
  block_id          String
  stripe_session_id String   @unique // idempotency key (NFR-D1)
  amount_cents      Int
  metres_added      Float
  created_at        DateTime @default(now())

  block Block @relation(fields: [block_id], references: [id])

  @@map("payments")
}

model PaymentDeadLetter {
  id                String   @id @default(cuid())
  stripe_session_id String
  event_type        String
  amount_cents      Int
  reason            String
  created_at        DateTime @default(now())

  @@index([stripe_session_id])
  @@map("payment_dead_letters")
}
