# Tower — Environment Variables
# Copy this file to .env.local and fill in values

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/tower"

# Redis connection string (Upstash or self-hosted)
REDIS_URL="redis://localhost:6379"
# OR for Upstash (edge-compatible):
# UPSTASH_REDIS_REST_URL="https://YOUR_ENDPOINT.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# Stripe keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Admin bearer token (generate with: openssl rand -hex 32)
ADMIN_SECRET="your-long-random-secret-here"

# Public base URL (no trailing slash)
BASE_URL="http://localhost:3000"

# ── Optional (engine constants — all have coded defaults) ────────────────────

# DOUBLE_EVERY_K=500
# MAX_GROWTH=8
# R0=1.0
# G0=0.65
# MIN_ENTRY_USD=5.00
# MIN_SPEND_USD=2.00
# SEASON_DAYS=90
# CEIL_PER_HOUR=40000
# POLL_INTERVAL_MS=10000
