# Tower — Environment Variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file with real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
#
# IMPORTANT: use a SEPARATE database per environment. Local dev and CI must NOT
# point at the production database — dev/test writes (and `prisma migrate`) would
# mutate live data. Set the production DATABASE_URL only in the Vercel dashboard
# (Project → Settings → Environment Variables, scoped to "Production"), and keep a
# distinct local database in .env.local for development.

# PostgreSQL connection string — runtime. MUST be the POOLED endpoint at scale:
# serverless functions open a connection each, so a direct URL exhausts Postgres
# under load (10k users). Use Neon's -pooler host (PgBouncer).
#
# CRITICAL for Prisma + PgBouncer: the pooled URL MUST include ?pgbouncer=true —
# without it, Prisma's prepared statements are rejected by PgBouncer (transaction
# mode) and every query 500s. Add &connection_limit=1 for serverless.
# Neon (POOLED):
#   postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# Supabase:  the :6543 pooler URL with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/tower"

# Direct (non-pooled) DB URL — used ONLY by `prisma migrate` (PgBouncer can't run
# migrations). The NON-pooler host, NO pgbouncer param. NOT the same as a pooled
# DATABASE_URL.
# Neon (DIRECT):  postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db?sslmode=require
DIRECT_URL="postgresql://user:password@localhost:5432/tower"

# ── Redis (Upstash) ───────────────────────────────────────────────────────────

# Upstash Redis REST URL (edge-compatible — do NOT use raw redis:// in edge)
# From Upstash console → your database → REST API tab
UPSTASH_REDIS_REST_URL="https://YOUR_ENDPOINT.upstash.io"

# Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ── Stripe ────────────────────────────────────────────────────────────────────

# Stripe secret key (sk_live_... in production, sk_test_... in development)
STRIPE_SECRET_KEY="sk_test_..."

# Stripe webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint
# Production URL: https://www.doomstack.lol/api/webhook/stripe
# Production may list live + test secrets comma-separated in one var.
# Local dev: `stripe listen --forward-to localhost:3000/api/webhook/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# NOTE: public client config (Firebase web config, site URL, poll interval) is
# NO LONGER read from NEXT_PUBLIC_* env — it lives in src/config/public.ts.

# ── Auth / Internal ───────────────────────────────────────────────────────────

# Random secret for middleware → API authentication
# Generate: openssl rand -hex 32
INTERNAL_TOKEN=""

# Admin API token for season rollover, hide, and refund endpoints
# Generate: openssl rand -hex 32
ADMIN_TOKEN=""

# ── App ───────────────────────────────────────────────────────────────────────

# Production base URL — no trailing slash
# Example: https://tower.yourdomain.com
BASE_URL="http://localhost:3000"

# ── Search engine site verification (optional) ───────────────────────────────
# Public ownership tokens rendered into <meta> tags — not secrets. Leave unset
# until the properties exist. See app/app/layout.tsx's generateMetadata.

# Google Search Console → Settings → Ownership verification → HTML tag method
# → paste just the "content" value (not the whole <meta> tag)
GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools → Settings → your site → verify → "Meta tag" method
# → paste just the "content" value
BING_SITE_VERIFICATION=""

# ── Firebase Admin (server-side) ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Firebase Client (public) ──────────────────────────────────────────────────
# Moved to code: src/config/public.ts (PUBLIC_CONFIG.firebase). No env needed.

# ── AI Social Media Agent ─────────────────────────────────────────────────────

# Social admin allowlist (comma-separated). At least one must be set for /admin/social.
ADMIN_UIDS="firebase-uid-1,firebase-uid-2"
ADMIN_EMAILS="admin@yourdomain.com"

# AES-256-GCM key for OAuth token encryption at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Vercel Cron auth — MUST equal ADMIN_TOKEN (ADR-11). Only needed if you add crons back.
CRON_SECRET=""

# OpenAI (or compatible) for content generation and agent chat
OPENAI_API_KEY="sk-..."
AI_MODEL="gpt-4o-mini"

# AI video generation (Runway Gen-4.5 text-to-video)
RUNWAY_API_KEY="key_..."
AI_VIDEO_MODEL="gen4.5"
AI_VIDEO_SECONDS="8"

# Optional: persist generated MP4s in Vercel Blob (recommended in production).
# Without this, previews use a local /tmp proxy (dev only).
BLOB_READ_WRITE_TOKEN=""

# TikTok for Developers — https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social/accounts/oauth/tiktok/callback"

# X (Twitter) API v2 — https://developer.x.com/
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_REDIRECT_URI="http://localhost:3000/api/social/accounts/oauth/x/callback"

# YouTube Data API v3 — Google Cloud Console
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/accounts/oauth/youtube/callback"

# ── Optional engine constants (all have coded defaults) ───────────────────────

# DOUBLE_EVERY_K=500
# MAX_GROWTH=8
# R0=1.0
# G0=0.65
# MIN_ENTRY_USD=5.00
# MIN_SPEND_USD=2.00
# SEASON_DAYS=90
# CEIL_PER_HOUR=40000
# POLL_INTERVAL_MS=10000
