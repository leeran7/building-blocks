# Copy to mobile/.env.preview.local (git-ignored), fill in, then run
# `pnpm cap:ios:preview` from app/. Only used by preview-mode builds;
# `pnpm cap:ios` / release builds always use https://www.doomstack.lol.

# Vercel deployment to talk to. The branch alias follows the latest push:
VITE_API_BASE=https://building-blocks-git-feature-payments-v2-leeran7s-projects.vercel.app

# Vercel -> Project Settings -> Deployment Protection -> Protection Bypass for Automation.
# Needed because preview URLs are behind Vercel Authentication.
VITE_VERCEL_BYPASS=
