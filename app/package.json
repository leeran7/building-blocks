{
  "name": "tower",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "setup": "pnpm install && pnpm run build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@stripe/stripe-js": "^2.3.0",
    "@upstash/redis": "^1.28.0",
    "@vercel/og": "^0.6.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.7.0",
    "next": "16.3.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.10.0",
    "stripe": "^14.9.0",
    "zod": "^3.22.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.28.0",
      "minimatch": ">=9.0.7",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.40.1",
    "postcss": "^8",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.8.1",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
