{
  "name": "tower",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && pnpm mobile:build:hosted && next build --webpack",
    "setup": "pnpm install && pnpm run build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:local": "tsx scripts/dbMigrateLocal.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "season:generate": "tsx scripts/season.ts generate",
    "season:verify": "tsx scripts/season.ts verify",
    "levels:season:open": "tsx scripts/levelSeasonOpen.ts",
    "typecheck": "tsc --noEmit",
    "mobile:typecheck": "tsc -p mobile/tsconfig.json --noEmit",
    "analyze": "ANALYZE=true next build --webpack",
    "mobile:dev": "vite --config mobile/vite.config.mts",
    "mobile:build": "vite build --config mobile/vite.config.mts",
    "mobile:build:hosted": "vite build --config mobile/vite.config.mts --mode telegram && vite build --config mobile/vite.config.mts --mode discord",
    "portal:package": "tsx scripts/packagePortal.ts",
    "cap:sync": "pnpm mobile:build && cap sync",
    "cap:ios": "pnpm cap:sync && open -a /Applications/Xcode.app ios/App/App.xcodeproj",
    "cap:ios:run": "pnpm cap:sync && cap run ios",
    "cap:android": "pnpm cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.1",
    "@capacitor-firebase/messaging": "8.5.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/native-purchases": "8.8.1",
    "@discord/embedded-app-sdk": "2.5.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@prisma/client": "6.19.3",
    "@upstash/redis": "1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "1.0.2",
    "ably": "^2.28.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.3",
    "stripe": "22.6.2",
    "zod": "4.6.2"
  },
  "pnpm": {
    "overrides": {
      "jwks-rsa>jose": "^5"
    },
    "patchedDependencies": {
      "@capgo/native-purchases@8.8.1": "patches/@capgo__native-purchases@8.8.1.patch"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@capacitor/cli": "^8.5.2",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-loader": "^10.1.1",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "happy-dom": "^20.14.5",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}