{
  "name": "tower",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "setup": "pnpm install && pnpm run build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "@prisma/client": "6.19.3",
    "@upstash/redis": "1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/og": "1.0.2",
    "ably": "^2.28.0",
    "ai": "^7.0.97",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "zod": "4.6.2"
  },
  "pnpm": {
    "overrides": {
      "jwks-rsa>jose": "^5"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-loader": "^10.1.1",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
